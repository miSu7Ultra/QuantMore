# ================================
# QuantMore 必需配置
# ================================

# 阿里云百炼 AI (DashScope) - LLM + Embedding
# 生产密钥获取方式：阿里云百炼控制台创建 API-KEY 后填入
AI_BAILIAN_API_KEY=your_dashscope_api_key_here

# Provider API Key 加密密钥（必填；生产环境请替换为随机长字符串，部署后保持不变）
# 生产生成方式：openssl rand -base64 32；★生成后绝不可更改，
# 改后数据库中所有已加密的 Provider Key 永久无法解密
APP_AI_CONFIG_ENCRYPTION_KEY=change_me_provider_api_key_encryption_key

# JWT 签名密钥（必填；保持不变的随机字符串）
# 生产生成方式：openssl rand -hex 32；HS256 需 ≥32 字节；改动=全员重新登录
APP_JWT_SECRET=change_me_jwt_secret

# ================================
# 模型服务配置
# ================================

# Moonshot AI / Kimi (https://platform.moonshot.cn/)
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-latest

# DeepSeek (https://platform.deepseek.com/)
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-chat

# 智谱 AI / GLM (https://open.bigmodel.cn/)
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-4-plus

# ================================
# 本地开发依赖（与 docker-compose.dev.yml 对齐，勿改端口）
# ================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=quantmore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

REDIS_HOST=localhost
REDIS_PORT=6380

APP_STORAGE_ENDPOINT=http://localhost:9002
APP_STORAGE_ACCESS_KEY=minioadmin
APP_STORAGE_SECRET_KEY=minioadmin
APP_STORAGE_BUCKET=quantmore

# ================================
# 知识库种子导入(按子目录切割,幂等)
# ================================
APP_SEED_KB_DIR=/Users/pengpai/Desktop/QuantMore/docs

# ================================
# 生产部署（单机 docker compose，与 docker-compose.yml 对齐）
# ================================
# 注：本段的 POSTGRES_PASSWORD 与上方开发段同名，docker compose 解析 .env 时后出现的值优先，
# 生产以本段为准；留空会触发 compose 的 :? 校验直接报错（安全兜底，避免弱口令上线）。
# APP_AI_CONFIG_ENCRYPTION_KEY / APP_JWT_SECRET / AI_BAILIAN_API_KEY / PROVIDER_* 沿用上方
# 「必需配置」段的定义，生产必须把 change_me 占位值替换为随机生成值（生成命令见各变量上方注释，
# 占位值不会被 compose 拦截，请勿遗漏）。
# 开发段的 localhost/5433 等 host/port 不影响生产：compose 已在 app 容器 environment 中固定
# 内部服务名（POSTGRES_HOST: postgres 等），宿主机 .env 里的开发值不会传入生产容器。

# 数据库密码（生成: openssl rand -hex 24）
POSTGRES_PASSWORD=

# MinIO 根凭据（生成: openssl rand -hex 24）
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# JWT 签名密钥 / Provider API Key 加密密钥：定义在上方「必需配置」段（生成方式见该段注释）：
#   APP_JWT_SECRET                 → openssl rand -hex 32；改动=全员重新登录
#   APP_AI_CONFIG_ENCRYPTION_KEY   → openssl rand -base64 32；★生成后绝不可更改

# 注册开关（首部署保持 true 注册首个管理员，完成后改 false）
APP_REGISTRATION_ENABLED=true

# CORS（同源反代下不触发，预留；有域名后改为 https://域名）
# CORS_ALLOWED_ORIGINS=http://1.2.3.4

# 种子导入目录（容器内路径，compose 已挂载 ./docs:/seed-docs:ro）
# APP_SEED_KB_DIR=/seed-docs
